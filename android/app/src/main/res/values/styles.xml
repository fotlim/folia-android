<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app paints its own chrome, so the platform bar colours are only used for the frame
         around the WebView: dark background, light foreground. -->
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/folia_background</item>
        <item name="android:colorBackground">@color/folia_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>
</resources>
